<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/auras_catalog_dialog_background"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@null"
            android:src="@drawable/auras_orbit_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/auras_sources_label"
                android:textColor="@color/aurasAccentBright"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/connect_catalog_title"
                android:textColor="@color/aurasText"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp"
        android:text="@string/connect_catalog_description"
        android:textColor="@color/aurasTextMuted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/repo_name_input"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="4dp"
        android:autofillHints="username"
        android:background="@drawable/auras_catalog_input_background"
        android:hint="@string/catalog_name_optional"
        android:imeOptions="actionNext"
        android:inputType="textCapSentences"
        android:nextFocusDown="@id/repo_url_input"
        android:paddingHorizontal="15dp"
        android:singleLine="true"
        android:textColor="@color/aurasText"
        android:textColorHint="@color/aurasTextMuted"
        tools:ignore="LabelFor" />

    <EditText
        android:id="@+id/repo_url_input"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="11dp"
        android:autofillHints="no"
        android:background="@drawable/auras_catalog_input_background"
        android:hint="@string/catalog_address"
        android:imeOptions="actionDone"
        android:inputType="textUri"
        android:nextFocusUp="@id/repo_name_input"
        android:paddingHorizontal="15dp"
        android:singleLine="true"
        android:textColor="@color/aurasText"
        android:textColorHint="@color/aurasTextMuted"
        tools:ignore="LabelFor" />

    <TextView
        android:id="@+id/text2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/catalog_name_help"
        android:textColor="@color/aurasTextMuted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/apply_btt_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_btt"
            style="@style/BlackButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:minWidth="72dp"
            android:text="@string/sort_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/apply_btt"
            style="@style/WhiteButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:minWidth="148dp"
            android:text="@string/catalog_connect" />
    </LinearLayout>
</LinearLayout>
