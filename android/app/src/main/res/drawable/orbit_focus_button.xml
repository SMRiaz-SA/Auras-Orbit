<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="@color/orbit_button_focus" /></shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle"><solid android:color="@color/orbit_button_selected" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/orbit_button_pressed" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/orbit_panel_raised" /></shape>
    </item>
</selector>
