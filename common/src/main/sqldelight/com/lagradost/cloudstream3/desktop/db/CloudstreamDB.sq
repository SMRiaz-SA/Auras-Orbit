CREATE TABLE IF NOT EXISTS KeyValueStore (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

insertKeyValue:
INSERT OR REPLACE INTO KeyValueStore(key, value) VALUES (?, ?);

selectKeyValue:
SELECT value FROM KeyValueStore WHERE key = ?;

deleteKeyValue:
DELETE FROM KeyValueStore WHERE key = ?;

selectAllKeyValues:
SELECT * FROM KeyValueStore;


CREATE TABLE IF NOT EXISTS Bookmarks (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    url TEXT NOT NULL,
    apiName TEXT NOT NULL,
    posterUrl TEXT,
    watchType INTEGER DEFAULT 0,
    dateAdded INTEGER DEFAULT 0
);

insertBookmark:
INSERT OR REPLACE INTO Bookmarks(id, name, url, apiName, posterUrl, watchType, dateAdded) VALUES (?, ?, ?, ?, ?, ?, ?);

deleteBookmark:
DELETE FROM Bookmarks WHERE id = ?;

selectAllBookmarks:
SELECT * FROM Bookmarks;

selectBookmarkById:
SELECT * FROM Bookmarks WHERE id = ?;


CREATE TABLE IF NOT EXISTS CustomLists (
    profileId INTEGER NOT NULL,
    id TEXT NOT NULL,
    name TEXT NOT NULL,
    normalizedName TEXT NOT NULL,
    sortOrder INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    showOnHome INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(profileId, id),
    UNIQUE(profileId, normalizedName)
);

insertCustomList:
INSERT INTO CustomLists(profileId, id, name, normalizedName, sortOrder, createdAt, showOnHome)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateCustomListName:
UPDATE CustomLists SET name = ?, normalizedName = ? WHERE profileId = ? AND id = ?;

updateCustomListSortOrder:
UPDATE CustomLists SET sortOrder = ? WHERE profileId = ? AND id = ?;

updateCustomListShowOnHome:
UPDATE CustomLists SET showOnHome = ? WHERE profileId = ? AND id = ?;

deleteCustomList:
DELETE FROM CustomLists WHERE profileId = ? AND id = ?;

selectCustomListsByProfile:
SELECT * FROM CustomLists WHERE profileId = ? ORDER BY sortOrder ASC, createdAt ASC, id ASC;

selectCustomListById:
SELECT * FROM CustomLists WHERE profileId = ? AND id = ?;

deleteCustomListsByProfile:
DELETE FROM CustomLists WHERE profileId = ?;


CREATE TABLE IF NOT EXISTS CustomListItems (
    profileId INTEGER NOT NULL,
    listId TEXT NOT NULL,
    bookmarkId TEXT NOT NULL,
    addedAt INTEGER NOT NULL,
    PRIMARY KEY(profileId, listId, bookmarkId)
);

insertCustomListItem:
INSERT OR IGNORE INTO CustomListItems(profileId, listId, bookmarkId, addedAt) VALUES (?, ?, ?, ?);

deleteCustomListItem:
DELETE FROM CustomListItems WHERE profileId = ? AND listId = ? AND bookmarkId = ?;

deleteCustomListItemsForList:
DELETE FROM CustomListItems WHERE profileId = ? AND listId = ?;

deleteCustomListItemsForBookmark:
DELETE FROM CustomListItems WHERE profileId = ? AND bookmarkId = ?;

deleteCustomListItemsByProfile:
DELETE FROM CustomListItems WHERE profileId = ?;

selectCustomListItemsByProfile:
SELECT * FROM CustomListItems WHERE profileId = ? ORDER BY addedAt DESC, listId ASC;


CREATE TABLE IF NOT EXISTS WatchHistory (
    parentId TEXT NOT NULL,
    episodeId TEXT NOT NULL,
    showName TEXT NOT NULL,
    showUrl TEXT NOT NULL,
    apiName TEXT NOT NULL,
    posterUrl TEXT,
    episodeThumbnailUrl TEXT,
    screenshotUrl TEXT,
    episode INTEGER,
    season INTEGER,
    position INTEGER NOT NULL,
    duration INTEGER NOT NULL,
    updateTime INTEGER NOT NULL,
    episodeName TEXT,
    episodeDescription TEXT,
    PRIMARY KEY(parentId, episodeId)
);

insertWatchHistory:
INSERT OR REPLACE INTO WatchHistory(parentId, episodeId, showName, showUrl, apiName, posterUrl, episodeThumbnailUrl, screenshotUrl, episode, season, position, duration, updateTime, episodeName, episodeDescription) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteWatchHistoryByParent:
DELETE FROM WatchHistory WHERE parentId = ?;

deleteWatchHistoryByEpisode:
DELETE FROM WatchHistory WHERE parentId = ? AND episodeId = ?;

deleteAllWatchHistory:
DELETE FROM WatchHistory;

selectAllWatchHistory:
SELECT * FROM WatchHistory ORDER BY updateTime DESC;

selectWatchHistoryByParent:
SELECT * FROM WatchHistory WHERE parentId = ? ORDER BY updateTime DESC;

selectWatchHistoryByEpisode:
SELECT * FROM WatchHistory WHERE parentId = ? AND episodeId = ? LIMIT 1;


CREATE TABLE IF NOT EXISTS FollowedShows (
    profileId INTEGER NOT NULL,
    providerName TEXT NOT NULL,
    showUrl TEXT NOT NULL,
    showName TEXT NOT NULL,
    posterUrl TEXT,
    tmdbId INTEGER,
    addedAt INTEGER NOT NULL,
    lastRefreshAt INTEGER NOT NULL DEFAULT 0,
    lastRefreshError TEXT,
    PRIMARY KEY(profileId, providerName, showUrl)
);

upsertFollowedShow:
INSERT OR REPLACE INTO FollowedShows(profileId, providerName, showUrl, showName, posterUrl, tmdbId, addedAt, lastRefreshAt, lastRefreshError)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllFollowedShows:
SELECT * FROM FollowedShows ORDER BY addedAt DESC;

deleteFollowedShow:
DELETE FROM FollowedShows WHERE profileId = ? AND providerName = ? AND showUrl = ?;

deleteFollowedShowsByProfile:
DELETE FROM FollowedShows WHERE profileId = ?;


CREATE TABLE IF NOT EXISTS EpisodeReleaseCache (
    tmdbId INTEGER NOT NULL,
    seasonNumber INTEGER NOT NULL,
    episodeNumber INTEGER NOT NULL,
    airDate TEXT NOT NULL,
    episodeName TEXT,
    overview TEXT,
    stillUrl TEXT,
    fetchedAt INTEGER NOT NULL,
    PRIMARY KEY(tmdbId, seasonNumber, episodeNumber)
);

upsertEpisodeRelease:
INSERT OR REPLACE INTO EpisodeReleaseCache(tmdbId, seasonNumber, episodeNumber, airDate, episodeName, overview, stillUrl, fetchedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectAllEpisodeReleases:
SELECT * FROM EpisodeReleaseCache ORDER BY airDate ASC;

deleteStaleEpisodeReleases:
DELETE FROM EpisodeReleaseCache WHERE fetchedAt < ?;

deleteEpisodeReleasesBySeason:
DELETE FROM EpisodeReleaseCache WHERE tmdbId = ? AND seasonNumber = ?;


CREATE TABLE IF NOT EXISTS EpisodeWatchMarks (
    profileId INTEGER NOT NULL,
    providerName TEXT NOT NULL,
    showUrl TEXT NOT NULL,
    episodeKey TEXT NOT NULL,
    episodeId TEXT NOT NULL,
    showName TEXT NOT NULL,
    seasonNumber INTEGER NOT NULL,
    episodeNumber INTEGER NOT NULL,
    watchedAt INTEGER NOT NULL,
    PRIMARY KEY(profileId, providerName, showUrl, episodeKey)
);

upsertEpisodeWatchMark:
INSERT OR REPLACE INTO EpisodeWatchMarks(profileId, providerName, showUrl, episodeKey, episodeId, showName, seasonNumber, episodeNumber, watchedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllEpisodeWatchMarks:
SELECT * FROM EpisodeWatchMarks ORDER BY watchedAt DESC;

deleteEpisodeWatchMark:
DELETE FROM EpisodeWatchMarks WHERE profileId = ? AND providerName = ? AND showUrl = ? AND episodeKey = ?;

deleteEpisodeWatchMarksByEpisode:
DELETE FROM EpisodeWatchMarks WHERE profileId = ? AND providerName = ? AND showUrl = ? AND seasonNumber = ? AND episodeNumber = ?;

deleteEpisodeWatchMarksByProfile:
DELETE FROM EpisodeWatchMarks WHERE profileId = ?;

selectLatestWatchHistoryForShow:
SELECT * FROM WatchHistory WHERE showUrl = ? ORDER BY updateTime DESC LIMIT 1;


CREATE TABLE IF NOT EXISTS PluginUpdateHistory (
    pluginName TEXT NOT NULL,
    version INTEGER NOT NULL,
    iconUrl TEXT,
    timestamp INTEGER NOT NULL,
    PRIMARY KEY (pluginName, version)
);

insertPluginUpdate:
INSERT OR REPLACE INTO PluginUpdateHistory(pluginName, version, iconUrl, timestamp) VALUES (?, ?, ?, ?);

selectAllPluginUpdates:
SELECT * FROM PluginUpdateHistory ORDER BY timestamp DESC;

deleteOldPluginUpdates:
DELETE FROM PluginUpdateHistory WHERE rowid NOT IN (SELECT rowid FROM PluginUpdateHistory ORDER BY timestamp DESC LIMIT 100);

deletePluginUpdate:
DELETE FROM PluginUpdateHistory WHERE pluginName = ?;

deleteAllPluginUpdates:
DELETE FROM PluginUpdateHistory;


CREATE TABLE IF NOT EXISTS DownloadTasks (
    id TEXT NOT NULL PRIMARY KEY,
    canonicalKey TEXT NOT NULL,
    showName TEXT NOT NULL,
    showUrl TEXT NOT NULL,
    episodeTitle TEXT,
    posterUrl TEXT,
    backdropUrl TEXT,
    season INTEGER,
    episode INTEGER,
    filePath TEXT NOT NULL,
    streamUrl TEXT NOT NULL,
    totalBytes INTEGER NOT NULL,
    downloadedBytes INTEGER NOT NULL,
    status TEXT NOT NULL,
    quality INTEGER NOT NULL,
    apiName TEXT NOT NULL,
    headersJson TEXT,
    dateAdded INTEGER NOT NULL,
    dateCompleted INTEGER
);

insertDownloadTask:
INSERT OR REPLACE INTO DownloadTasks(id, canonicalKey, showName, showUrl, episodeTitle, posterUrl, backdropUrl, season, episode, filePath, streamUrl, totalBytes, downloadedBytes, status, quality, apiName, headersJson, dateAdded, dateCompleted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateDownloadProgress:
UPDATE DownloadTasks SET downloadedBytes = ?, totalBytes = ?, status = ? WHERE id = ?;

updateDownloadStatus:
UPDATE DownloadTasks SET status = ?, dateCompleted = ? WHERE id = ?;

deleteDownloadTask:
DELETE FROM DownloadTasks WHERE id = ?;

selectAllDownloads:
SELECT * FROM DownloadTasks ORDER BY dateAdded DESC;

selectActiveDownloads:
SELECT * FROM DownloadTasks WHERE status IN ('QUEUED', 'DOWNLOADING', 'PAUSED') ORDER BY dateAdded ASC;

selectCompletedDownloads:
SELECT * FROM DownloadTasks WHERE status = 'COMPLETED' ORDER BY dateCompleted DESC;

selectDownloadById:
SELECT * FROM DownloadTasks WHERE id = ?;

selectDownloadByCanonical:
SELECT * FROM DownloadTasks WHERE canonicalKey = ? AND season = ? AND episode = ?;

